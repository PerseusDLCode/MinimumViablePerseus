<!doctype html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{% block title %}{% endblock %}</title>
        <link
            href="{{ url_for('static', filename="images/favicon.png") }}"
            rel="icon"
            type="image/png"
        />
        <link
            href="{{ url_for('static', filename="css/output.css") }}"
            rel="stylesheet"
            type="text/css"
        />
    </head>
    <body class="bg-base-100 min-h-screen">
        {% block header %}{% endblock %}
            <div class="navbar bg-primary text-primary-content font-bold">
                <div class="navbar-start">
                    <div class="dropdown">
                        <div tabindex="0" role="button" class="btn lg:hidden">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
                            </svg>
                        </div>
                        <ul tabindex="-1"
                            class="menu menu-sm dropdown-content bg-primary z-1 mt-3 w-52 p-2 shadow">
                            <li><a href="{{ url_for('index') }}" class="hover:text-primary-content">Home</a></li>
                            <li><a href="{{ url_for('get_collections') }}" class="hover:text-primary-content">Collections/Texts</a></li>
                            <li><a href="https://catalog.perseus.org" class="hover:text-primary-content">Perseus Catalog</a></li>
                            <li><a href="{{ url_for('get_research') }}" class="hover:text-primary-content">Research</a></li>
                            <li><a href="{{ url_for('get_grants') }}" class="hover:text-primary-content">Grants</a></li>
                            <li><a href="{{ url_for('get_open_source') }}" class="hover:text-primary-content">Open Source</a></li>
                            <li><a href="{{ url_for('get_about') }}" class="hover:text-primary-content">About</a></li>
                            <li><a href="{{ url_for('get_abbreviations') }}" class="hover:text-primary-content">Abbreviations</a></li>
                            <li><a href="{{ url_for('get_help') }}" class="hover:text-primary-content">Help</a></li>
                        </ul>
                    </div>
                </div>
                <div class="navbar-center hidden lg:flex">
                    <ul class="menu menu-horizontal px-1">
                        <li><a href="{{ url_for('index') }}" class="hover:text-primary-content">Home</a></li>
                        <li><a href="{{ url_for('get_collections') }}" class="hover:text-primary-content">Collections/Texts</a></li>
                        <li><a href="https://catalog.perseus.org" class="hover:text-primary-content">Perseus Catalog</a></li>
                        <li><a href="{{ url_for('get_research') }}" class="hover:text-primary-content">Research</a></li>
                        <li><a href="{{ url_for('get_grants') }}" class="hover:text-primary-content">Grants</a></li>
                        <li><a href="{{ url_for('get_open_source') }}" class="hover:text-primary-content">Open Source</a></li>
                        <li><a href="{{ url_for('get_about') }}" class="hover:text-primary-content">About</a></li>
                        <li><a href="{{ url_for('get_abbreviations') }}" class="hover:text-primary-content">Abbreviations</a></li>
                        <li><a href="{{ url_for('get_help') }}" class="hover:text-primary-content">Help</a></li>
                    </ul>
                </div>
                <div class="navbar-end">
                </div>
            </div>
        </div>
        <script>
        (function () {
            // The table-of-contents nav lives in a same-origin iframe (see
            // nav_fragment.html.jinja), which is a separate document and so
            // doesn't pick up daisyUI's CSS-only theme-controller mechanism
            // (`:root:has(.theme-controller:checked)`). Mirror the chosen
            // theme onto every iframe's document explicitly instead.
            function applyThemeToFrames(theme) {
                document.querySelectorAll('iframe').forEach(function (iframe) {
                    const doc = iframe.contentDocument;
                    if (doc && doc.documentElement) {
                        doc.documentElement.setAttribute('data-theme', theme);
                    }
                });
            }


            document.querySelectorAll('input.theme-controller').forEach(function (input) {
                input.addEventListener('change', function () {
                    if (input.checked) applyThemeToFrames(input.value);
                });
            });

            // Lazily-loaded iframes (e.g. the mobile TOC dropdown) may finish
            // loading after a theme has already been chosen; sync them too.
            document.querySelectorAll('iframe').forEach(function (iframe) {
                iframe.addEventListener('load', function () {
                    const checked = document.querySelector('input.theme-controller:checked');
                    if (checked) applyThemeToFrames(checked.value);
                });
            });
        }());
        </script>
        {% block content %}
        {% endblock %}
        {% block scripts %}{% endblock %}
    </body>
</html>
