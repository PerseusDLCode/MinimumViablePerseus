<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <!-- Fetched by reading.html.jinja (static/js/siblingFragments.js),
             which moves this <body>'s children into a sibling's panel;
             the stylesheet only matters when this page is opened directly. -->
        <link href="{{ url_for('static', filename="css/output.css") }}"
              rel="stylesheet"
              type="text/css" />
    </head>
    <body data-lang="{{ chunk.language }}">
        {# Notes are discarded here, as they were when sibling text was
           inlined into the reading page: only the base text's notes are
           listed there. #}
        {% with notes = namespace(items=[]) %}
            {% for element in chunk.elements %}
                {% with text_container = element %}
                    {% include 'components/ReadableTextContainer.html.jinja' %}
                {% endwith %}
            {% endfor %}
        {% endwith %}
    </body>
</html>
