{% extends 'base.html.jinja' %}

{% block title %}Collections – Perseus Digital Library{% endblock %}

{% block header %}
    <div class="py-4">
        <img src="{{ url_for('static', filename='images/perseus-banner.png') }}" />
    </div>
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">Collections</h1>

    <div class="mb-6">
        <input
            type="search"
            id="collections-search"
            autocomplete="off"
            placeholder="Search by title, author, or editor…"
            class="input input-bordered w-full"
        />
        <div id="collections-search-results" class="collapse bg-base-100 border border-neutral-300 border-t-0 rounded-b">
            <div class="collapse-content !p-0">
                <ul class="max-h-96 overflow-y-auto divide-y divide-neutral-200"></ul>
            </div>
        </div>
    </div>

    {% for corpus in collections|sort(attribute="label") %}
    <section class="mb-6">
        <details>
            <summary class="text-xl font-semibold border-b border-neutral-300 pb-1 mb-2 cursor-pointer">{{ corpus.label }}</summary>

            <div class="pl-6 mt-2">
                {% for tg in corpus.textgroups|sort(attribute="author,id") %}
                <div class="mb-3">
                    <details>
                        <summary class="text-base font-semibold text-neutral-700 cursor-pointer">{{ tg.author or tg.id }}</summary>

                        <ul class="pl-6 mt-1">
                            {% for work in tg.works %}
                            <li class="mb-1">
                                <ul class="pl-6 space-y-0.5">
                                    {% for version in work.versions|sort(attribute="title,id") %}
                                    {# A live combined build resolves first_chunk_kwargs via url_for here;
                                       a global build stitched from per-corpus manifests (see
                                       _build_corpus_manifest) has no kwargs to resolve — it already
                                       carries the resolved href, computed at corpus-build time. #}
                                    <li>
                                        <a href="{{ version.href if version.href is defined else url_for("reading_view", **version.first_chunk_kwargs) }}" class="link text-sm">
                                            {{ version.title }} ({{ version.language_label }}){% if version.editors %} — {{ version.editors }}{% endif %}
                                        </a>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            {% endfor %}
                        </ul>
                    </details>
                </div>
                {% endfor %}
            </div>
        </details>
    </section>
    {% else %}
    <p class="text-neutral-500">No collections available.</p>
    {% endfor %}
</div>
{% endblock %}

{% block scripts %}
<script type="text/ecmascript" src="{{ url_for("static", filename="js/collectionsSearch.js") }}"></script>
<script type="text/ecmascript">
    collectionsSearch('collections-search', 'collections-search-results');
</script>
{% endblock %}
