<!doctype html>
<html class="overscroll-contain bg-primary">
    <head>
        <meta charset="utf-8" />
        <!-- Links here must navigate the outer reading page, not this
             iframe's own document. -->
        <base target="_parent" />
        <link
            href="{{ url_for('static', filename="css/output.css") }}"
            rel="stylesheet"
            type="text/css"
        />
    </head>
    <body class="text-xs text-primary-content p-4 text-primary-content overscroll-contain">
        <h3 class="font-bold">Table of Contents:</h3>
        <ul class="menu [&_li>*]:rounded-none flex-nowrap w-full">
            {% for nav_item in toc.get("table_of_contents", []) %}
                {% with item = nav_item %}
                    {% include 'components/NavigationItem.html.jinja' %}
                {% endwith %}
            {% endfor %}
        </ul>
        <script src="{{ url_for('static', filename='js/navFragmentCurrent.js') }}"></script>
    </body>
</html>
